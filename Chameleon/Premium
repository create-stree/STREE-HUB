local function applyHighlight(player, char)
    if player == LocalPlayer then return end
    if char:FindFirstChild("ChameleonESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name    = "ChameleonESP"
    highlight.Adornee = char
    highlight.Parent  = char

    task.spawn(function()
        while char and char.Parent do
            task.wait(1)
            if not Config.ESPEnabled then
                highlight.Enabled = false
            else
                highlight.Enabled = true
                local isSeeker = false

                if player.Team then
                    local teamName = player.Team.Name:lower()
                    if string.find(teamName, "seeker") or string.find(teamName, "hunter") then
                        isSeeker = true
                    end
                end
                if player:GetAttribute("IsSeeker") == true then
                    isSeeker = true
                end

                if isSeeker then
                    highlight.FillColor    = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                else
                    highlight.FillColor    = Color3.fromRGB(0, 150, 255)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    end)
end

local function updateESP(player)
    if player == LocalPlayer then return end
    if player.Character then applyHighlight(player, player.Character) end
    player.CharacterAdded:Connect(function(char)
        applyHighlight(player, char)
    end)
end

for _, p in pairs(Players:GetPlayers()) do updateESP(p) end
Players.PlayerAdded:Connect(updateESP)


