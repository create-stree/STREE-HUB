            aa.Name = 'BoxFrame'
            aa.BackgroundTransparency = 1
            aa.Size = UDim2.new(1, 0, 1, 0)
            aa.BorderSizePixel = 2
            aa.Parent = _

            local ab = Instance.new('UIStroke')

            ab.Name = 'Stroke'
            ab.Thickness = 2
