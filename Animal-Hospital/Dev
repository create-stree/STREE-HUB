local tpCooldown = false
local function teleportTo(roomName)
    if tpCooldown then
        notify("Teleport", "Cooldown active. Please wait.", 2, "clock")
        return
    end
    local cf   = roomCFrames[roomName]
    local root = getRoot()
    if cf and root then
        pcall(function() root.CFrame = cf end)
        tpCooldown = true
        notify("Teleport", "Teleported to " .. roomName, 2, "map-pin")
        task.wait(0.5)
        tpCooldown = false
    else
        notify("Teleport", "Failed to teleport.", 2, "x-circle")
    end
end

